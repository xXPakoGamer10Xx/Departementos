  "narrative": {
    "northStar": "El talonario",
    "overview": "Habita se ve como un talonario de recibos bien llevado: hojas blancas sobre papel frío, renglones finos, folios y números tabulares. Un solo azul de acción, sin sombras; la perforación es la firma.",
    "keyCharacteristics": [
      "Tema claro único",
      "Hojas blancas con borde de 1px y sin sombras",
      "Perforación punteada como firma",
      "Geist; Geist Mono solo para folios",
      "Un acento; rojo, verde y ámbar solo como estado"
    ],
    "rules": [
      {
        "name": "The One Ink Rule",
        "body": "El azul aparece solo en acciones, navegación activa, foco y selección.",
        "section": "colors"
      },
      {
        "name": "The Stamp Only Rule",
        "body": "El rojo significa error o reverso, nunca énfasis.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Toda cifra es tabular y los importes se alinean a la derecha.",
        "section": "typography"
      },
      {
        "name": "The Flat Leaf Rule",
        "body": "Ninguna hoja proyecta sombra; se separa con renglones o perforaciones.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar Carbon-Copy Blue solo para acciones, navegación activa y foco.",
      "Do separar con renglones de 1px y perforaciones, no con sombras.",
      "Do dar a cada pantalla estados de carga, vacío, error y éxito."
    ],
    "donts": [
      "Don't usar tarjetas de icono + título + texto como estructura de página.",
      "Don't usar rojo para enfatizar.",
      "Don't introducir tema oscuro ni degradados decorativos.",
      "Don't usar azul en etiquetas de rol, avatares o datos."
    ]
  }
