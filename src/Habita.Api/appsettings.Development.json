{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=habita;Username=habita;Password=change-me"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Auth": {
    "ExposeInvitationTokens": true
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}