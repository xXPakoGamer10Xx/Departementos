# Copy to .env.production and fill in EVERY value. Never commit the real file.
# Generate secrets with:  openssl rand -hex 24   (avoid ';' and spaces in the database password)

# Public domain served over HTTPS (DNS must point at this host; ports 80 and 443 must be reachable).
DOMAIN=habita.example.com
# Required: Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=admin@example.com

POSTGRES_USER=habita
POSTGRES_DB=habita
POSTGRES_PASSWORD=

# Outgoing e-mail (invitations and password recovery).
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@habita.example.com

# Optional: notifications on the phone or computer (Web Push). Leave empty to keep only in-app and email notices.
# Generate the pair once with:  docker compose -f docker-compose.prod.yml --env-file .env.production run --rm migrate --generate-vapid
# Keep the private key secret. Use the same pair from now on: changing it disconnects every registered device.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Backups
BACKUP_PATH=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Only change when ports 80/443 are taken on the host (e.g. testing next to another site).
HTTP_PORT=80
HTTPS_PORT=443

# Only if the public site is NOT served on the default HTTPS port (e.g. https://habita.example.com:8443): the exact public origin.
# PUBLIC_ORIGIN=https://habita.example.com:8443
